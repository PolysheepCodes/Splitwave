# Where browsers download the models from (the folder that holds manifest.json and the .onnx files).
#   Hugging Face:  VITE_MODELS_URL=https://huggingface.co/<user>/<repo>/resolve/main/
#   Your server:   leave empty -> models/ next to the app (serve the models/ folder at /models/)
VITE_MODELS_URL=https://huggingface.co/TheDailyOWO/splitwave-models/resolve/main/

# Donation banner at the top of the page (a Buy Me a Coffee link, or any https:// page). Empty = no banner.
VITE_DONATE_URL=https://buymeacoffee.com/thedailyowo
